
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/privacy_policy_tracker

# Google AI Studio API Key for Gemini 1.5 Flash
GEMINI_API_KEY=your_google_ai_studio_key_here

# Allowed Chrome Extension Origin for Production CORS
ALLOWED_ORIGIN=chrome-extension://<your-extension-id>
